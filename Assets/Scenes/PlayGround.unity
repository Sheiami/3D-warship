  m_Script: {fileID: 11500000, guid: ee2e3d7139f7dff4290a5052aeb55871, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ControlsHelp
  toggleButton: {fileID: 1483146544}
  panel: {fileID: 516670120}
  content: {fileID: 1529605852}
  sections:
  - title: "\u041A\u043E\u0440\u0430\u0431\u043B\u0456"
    lines: "Shift+\u041B\u041A\u041C \u043F\u043E \u043A\u043E\u0440\u0430\u0431\u043B\u044E -  \u0432\u0438\u0431\u0456\u0440\r\nShift+\u041B\u041A\u041C \u0443 \u043F\u043E\u0440\u043E\u0436\u043D\u0454 - \u0437\u043D\u044F\u0442\u0438 \u0432\u0438\u0431\u0456\u0440\r\n\u041B\u041A\u041C \u043F\u043E \u0432\u043E\u0434\u0456 - \u0440\u0443\u0445"
  - title: "\u0411\u0456\u0439"
    lines: "\u041B\u041A\u041C \u043F\u043E \u0432\u043E\u0440\u043E\u0433\u0443 - \u0430\u0442\u0430\u043A\u0430\r\n\u041B\u041A\u041C \u043F\u043E \u0432\u043E\u0434\u0456 - \u0441\u043A\u0430\u0441\u0443\u0432\u0430\u0442\u0438 \u0430\u0442\u0430\u043A\u0443\r\n1, 2 - \u0432\u0438\u0431\u0456\u0440 \u0437\u0431\u0440\u043E\u0457"
  - title: "\u0414\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u043E"
    lines: "\u041F\u043E\u0441\u0442\u0440\u0456\u043B = 1 \u043D\u0430\u0431\u0456\u0439 \u0437\u0456 \u0441\u043A\u043B\u0430\u0434\u0443\r\n\u041D\u0430\u0431\u043E\u0457 - \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0456 ($)\r\n\u0412\u043E\u0440\u043E\u0433\u0430 \u0432\u0438\u0434\u043D\u043E \u043B\u0438\u0448\u0435 \u043F\u043E\u0431\u043B\u0438\u0437\u0443\r\n\u0441\u0432\u043E\u0433\u043E \u043A\u043E\u0440\u0430\u0431\u043B\u044F\nCtrl+\u041B\u041A\u041C \u0456 \u043F\u043E\u0442\u044F\u0433\u043D\u0443\u0442\u0438 - \u0432\u0438\u0431\u0456\u0440 \u0440\u0430\u043C\u043A\u043E\u044E\n - (\u041B\u041A\u041C \u043F\u043E \u0432\u043E\u0434\u0456 - \u0440\u0443\u0445 \u0443\u0441\u0456\u0445 \u0432\u0438\u0431\u0440\u0430\u043D\u0438\u0445)"
